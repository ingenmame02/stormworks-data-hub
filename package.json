{
  "name": "stormworks-wiki",
  "version": "0.0.0",
  "private": true,
    "scripts": {
    "docusaurus": "docusaurus",
    "prebuild": "python tools/generate_parts_index.py",
    "prestart": "python tools/generate_parts_index.py",
    "pretypecheck": "python tools/generate_parts_index.py",
    "start": "docusaurus start",
    "start:ja": "docusaurus start --locale ja",
    "start:en": "docusaurus start --locale en",
    "test": "node --test",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "edit-part-data": "python tools/edit_part_data.py",
    "edit-part-translations": "python tools/edit_part_data.py --translate",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.3.0",
    "typescript": "7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
